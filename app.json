{
  "expo": {
    "name": "Great Waters",
    "slug": "great-waters-ems",
    "version": "1.0.0",
    "scheme": "greatwaters",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greatwaters.ems",
      "infoPlist": {
        "NSCameraUsageDescription": "Great Waters uses the camera to photograph bills and receipts for your expense claims.",
        "NSPhotoLibraryUsageDescription": "Great Waters needs access to your photos so you can attach bills and receipts to expense claims."
      }
    },
    "android": {
      "package": "com.greatwaters.ems",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Great Waters uses the camera to photograph bills and receipts for your expense claims.",
          "photosPermission": "Great Waters needs access to your photos so you can attach bills and receipts to expense claims."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#156B9E"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://192.168.1.10:8000/api/v1",
      "eas": {
        "projectId": ""
      }
    }
  }
}
